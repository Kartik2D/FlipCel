{
  "name": "flipcel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:kernel": "wasm-pack build kernel/wasm --release --target web --out-dir ../../src/vector/pkg --out-name kernel && rm -f src/vector/pkg/.gitignore",
    "test:kernel": "cargo test --manifest-path kernel/Cargo.toml -p dcel",
    "check:kernel": "node --import ./scripts/ts-resolve.mjs src/vector/kernel.check.ts",
    "check:symbols": "node --import ./scripts/ts-resolve.mjs src/vector/symbols.check.ts",
    "check:refit": "node --import ./scripts/ts-resolve.mjs src/editing/direct-select/refit.check.ts"
  },
  "dependencies": {
    "@visioncortex/vtracer": "^1.0.0-alpha.4",
    "esm-potrace-wasm": "^0.4.1",
    "firebase": "^12.19.0",
    "lit": "^3.3.1",
    "paper": "^0.12.18",
    "reinvented-color-wheel": "^0.4.0"
  },
  "devDependencies": {
    "@types/paper": "^0.11.14",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
